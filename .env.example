# Beispielkonfiguration – kopieren nach .env und anpassen. .env niemals committen.
PORT=3000
DATABASE_PATH=./data/cockpit.sqlite

# Vorführmodus: Vorführleiste und Simulator-Adressen unter /api/v1/sim (nur im Prototyp)
COCKPIT_DEMO=1

# Anbindungen im Prototyp simuliert
SAP_MODE=simulated
AGENT_MODE=simulated
AGENT_RUN_TIME=06:30
