# Beispielkonfiguration – kopieren nach .env und anpassen. .env niemals committen.
PORT=3000
DATABASE_PATH=./data/cockpit.sqlite

# Anmeldung (ein Nutzer). Im Prototyp ein einfaches Passwort – vor der ersten Nutzung ändern.
COCKPIT_PASSWORD=cockpit-demo
# Schlüssel für das Sitzungs-Cookie: 64 Hexzeichen. Bleibt er leer, erzeugt `npm run einrichten` einen.
COCKPIT_SESSION_SECRET=
# Schlüssel, mit dem sich der (simulierte) Agent an der API anmeldet. Nur für den Prototyp.
COCKPIT_AGENT_KEY=demo-agent-schluessel-nur-fuer-den-prototyp

# Vorführmodus: Vorführleiste und Simulator-Adressen unter /api/v1/sim (nur im Prototyp)
COCKPIT_DEMO=1

# Anbindungen im Prototyp simuliert
SAP_MODE=simulated
AGENT_MODE=simulated
AGENT_RUN_TIME=06:30
